# Application Configuration
APP_NAME="Enterprise Flutter App"
APP_ENV=production
APP_VERSION=1.0.0

# Author & Ownership
AUTHOR_NAME="Eng. MHD. Shadi AL-Hasan"
AUTHOR_EMAIL=mhd.shadi.alhasan@gmail.com
AUTHOR_PHONE=+963934005922
AUTHOR_LOCATION="Damascus, Syria"

# Networking & HTTP Routing
API_BASE_URL=https://api.enterprise.domain.com/v1
API_TIMEOUT_MS=15000
API_RETRY_ATTEMPTS=3

# Sync Queue Persistence
OFFLINE_SYNC_ENABLED=true
SYNC_STORAGE_KEY=modular_sync_queue_v1
SYNC_MAX_QUEUE_SIZE=500
SYNC_FLUSH_INTERVAL_SECONDS=30

# Feature Toggles
ENABLE_NETWORK_INSPECTOR=true
ENABLE_ANALYTICS=false
DEBUG_LOGGING=true
